# --------------------------------------------------------------------
# Payload CMS
# --------------------------------------------------------------------
# Postgres connection string. Use Neon, Supabase, RDS, or local Postgres.
DATABASE_URI=postgres://USER:PASSWORD@HOST:5432/iportfolio

# Long random string used to sign cookies/JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# Public site URL (no trailing slash). Used by Payload for emails, etc.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --------------------------------------------------------------------
# Resend (contact form)
# --------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL="ImranX <hello@your-domain.com>"
CONTACT_TO_EMAIL=imranlabs@yahoo.com

# --------------------------------------------------------------------
# Vercel Blob storage (production media uploads)
# --------------------------------------------------------------------
# Auto-set by Vercel when you add the Blob Storage integration.
# Leave empty in local dev to use the on-disk media/ folder instead.
BLOB_READ_WRITE_TOKEN=
